import { useEffect, useState } from 'react'
import { useRouter } from 'next/router'
import { supabase } from '../../src/lib/supabase'
const PERMISSION_GROUPS = [
  {
    group: '👤 Profiles',
    perms: [
      { key: 'can_add_profiles',    label: 'Add new profiles',        desc: 'Create new candidate profiles' },
      { key: 'can_edit_profiles',   label: 'Edit profiles',           desc: 'Edit existing candidate details' },
      { key: 'can_delete_profiles', label: 'Delete profiles',         desc: 'Permanently delete profiles' },
      { key: 'can_view_contacts',   label: 'View contact details',    desc: 'See mobile numbers and emails' },
    ]
  },
  {
    group: '💼 Jobs & BD',
    perms: [
      { key: 'can_create_jd',   label: 'Create Job Descriptions', desc: 'Post new job requirements' },
      { key: 'can_view_bd',     label: 'View Client Pipeline',    desc: 'Access BD / Client management' },
      { key: 'can_edit_bd',     label: 'Edit Client Pipeline',    desc: 'Add and update client records' },
    ]
  },
  {
    group: '📊 Data & Reports',
    perms: [
      { key: 'can_export_data',   label: 'Export data',        desc: 'Download profiles and reports' },
      { key: 'can_view_reports',  label: 'View analytics',     desc: 'Access reports and dashboards' },
      { key: 'can_bulk_message',  label: 'Bulk messaging',     desc: 'Send WhatsApp/Email to multiple profiles' },
    ]
  },
  {
    group: '👥 Team',
    perms: [
      { key: 'can_manage_team', label: 'Manage team members', desc: 'Add, remove, and change roles' },
    ]
  },
]

const ROLE_DEFAULTS: Record<string, Record<string, boolean>> = {
  team_manager:   { can_add_profiles:true,  can_edit_profiles:true,  can_delete_profiles:true,  can_view_contacts:true,  can_export_data:true,  can_view_bd:true,  can_edit_bd:true,  can_create_jd:true,  can_view_reports:true,  can_manage_team:true,  can_bulk_message:true },
  team_leader:    { can_add_profiles:true,  can_edit_profiles:true,  can_delete_profiles:false, can_view_contacts:true,  can_export_data:false, can_view_bd:false, can_edit_bd:false, can_create_jd:true,  can_view_reports:true,  can_manage_team:false, can_bulk_message:true },
  sr_recruiter:   { can_add_profiles:true,  can_edit_profiles:true,  can_delete_profiles:false, can_view_contacts:true,  can_export_data:false, can_view_bd:false, can_edit_bd:false, can_create_jd:false, can_view_reports:false, can_manage_team:false, can_bulk_message:true },
  recruiter:      { can_add_profiles:true,  can_edit_profiles:true,  can_delete_profiles:false, can_view_contacts:true,  can_export_data:false, can_view_bd:false, can_edit_bd:false, can_create_jd:false, can_view_reports:false, can_manage_team:false, can_bulk_message:true },
  bd_manager:     { can_add_profiles:false, can_edit_profiles:false, can_delete_profiles:false, can_view_contacts:true,  can_export_data:true,  can_view_bd:true,  can_edit_bd:true,  can_create_jd:true,  can_view_reports:true,  can_manage_team:false, can_bulk_message:true },
  bd_executive:   { can_add_profiles:false, can_edit_profiles:false, can_delete_profiles:false, can_view_contacts:true,  can_export_data:false, can_view_bd:true,  can_edit_bd:true,  can_create_jd:false, can_view_reports:false, can_manage_team:false, can_bulk_message:true },
}

export default function PermissionsPage() {
  const router = useRouter()
  const [appUser, setAppUser] = useState<any>(null)
  const [members, setMembers] = useState<any[]>([])
  const [permissions, setPermissions] = useState<Record<string, any>>({})
  const [selectedMember, setSelectedMember] = useState<string>('')
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [saved, setSaved] = useState(false)

  useEffect(() => { load() }, [])

  async function load() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) { router.push('/'); return }
    const { data: user } = await supabase.from('app_users').select('*').eq('id', session.user.id).single()
    if (!user || !['account_owner', 'super_admin', 'admin'].includes(user.role)) {
      router.push('/dashboard'); return
    }
    setAppUser(user)

    const { data: mems } = await supabase
      .from('app_users')
      .select('*')
      .eq('company_id', user.company_id)
      .neq('id', user.id)
      .eq('status', 'active')
      .order('full_name')
    setMembers(mems || [])

    // Load all permissions for company
    const { data: perms } = await supabase
      .from('user_permissions')
      .select('*')
      .eq('company_id', user.company_id)

    const permsMap: Record<string, any> = {}
    perms?.forEach(p => { permsMap[p.user_id] = p })
    setPermissions(permsMap)
    setLoading(false)
  }

  function getPerms(userId: string) {
    return permissions[userId] || {}
  }

  function togglePerm(userId: string, key: string) {
    setPermissions(prev => ({
      ...prev,
      [userId]: {
        ...prev[userId],
        [key]: !prev[userId]?.[key]
      }
    }))
  }

  function applyRoleDefaults(userId: string, role: string) {
    const defaults = ROLE_DEFAULTS[role] || ROLE_DEFAULTS['recruiter']
    setPermissions(prev => ({
      ...prev,
      [userId]: { ...prev[userId], ...defaults }
    }))
  }

  async function savePermissions() {
    setSaving(true)
    for (const member of members) {
      const perms = permissions[member.id] || {}
      await supabase.from('user_permissions').upsert({
        company_id: appUser.company_id,
        user_id: member.id,
        ...perms,
        updated_at: new Date().toISOString(),
      }, { onConflict: 'company_id,user_id' })
    }
    setSaving(false)
    setSaved(true)
    setTimeout(() => setSaved(false), 2500)
  }

  const S: any = {
    card: { background:'var(--bg2)', border:'1px solid var(--bd)', borderRadius:14, padding:20, marginBottom:16 },
    toggle: (on: boolean) => ({
      width:42, height:24, borderRadius:12,
      background: on ? 'var(--ac)' : 'var(--bg4,#2a2f45)',
      border: `1px solid ${on ? 'var(--ac)' : 'var(--bd)'}`,
      cursor:'pointer', position:'relative' as const,
      transition:'all 0.2s', flexShrink:0,
    }),
    dot: (on: boolean) => ({
      position:'absolute' as const,
      top:3, left: on ? 20 : 3,
      width:16, height:16, borderRadius:'50%',
      background:'#fff',
      transition:'left 0.2s',
      boxShadow:'0 1px 3px rgba(0,0,0,0.3)',
    }),
  }

  if (loading) return (
    <div style={{minHeight:'100vh',display:'flex',alignItems:'center',justifyContent:'center',background:'var(--bg,#0e1117)'}}>
      
      <div style={{width:36,height:36,border:'3px solid var(--ac,#6c8cff)',borderTopColor:'transparent',borderRadius:'50%',animation:'spin 0.8s linear infinite'}}/>
      <style>{`@keyframes spin{to{transform:rotate(360deg)}}`}</style>
    </div>
  )

  return (
    
      <div style={{flex:1, overflowY:'auto', padding:'20px'}}>
        <div style={{maxWidth:800, margin:'0 auto'}}>

          {/* Header */}
          <div style={{display:'flex', justifyContent:'space-between', alignItems:'flex-start', marginBottom:20}}>
            <div>
              <div style={{fontSize:18, fontWeight:800, marginBottom:4}}>⚙️ Permission Panel</div>
              <div style={{fontSize:12, color:'var(--mu)'}}>Control what each team member can do in your company workspace.</div>
            </div>
            <button onClick={savePermissions} disabled={saving}
              style={{padding:'10px 24px', borderRadius:10, background:'var(--ac)', color:'#fff', border:'none', cursor:'pointer', fontSize:13, fontWeight:700, fontFamily:'inherit', opacity:saving?0.7:1}}>
              {saving ? '⏳ Saving...' : saved ? '✅ Saved!' : '💾 Save All'}
            </button>
          </div>

          {members.length === 0 && (
            <div style={{...S.card, textAlign:'center', padding:40}}>
              <div style={{fontSize:32, marginBottom:10}}>👥</div>
              <div style={{fontSize:14, fontWeight:600, marginBottom:6}}>No team members yet</div>
              <div style={{fontSize:12, color:'var(--mu)', marginBottom:16}}>Share your invite link to add members first</div>
              <button onClick={()=>router.push('/dashboard/invite')}
                style={{padding:'8px 20px', borderRadius:8, background:'var(--acbg)', color:'var(--ac)', border:'1px solid var(--bd)', cursor:'pointer', fontSize:13, fontFamily:'inherit'}}>
                Go to Invite Page →
              </button>
            </div>
          )}

          {members.map(member => (
            <div key={member.id} style={S.card}>
              {/* Member header */}
              <div style={{display:'flex', alignItems:'center', gap:12, marginBottom:16, paddingBottom:14, borderBottom:'1px solid var(--bd)'}}>
                <div style={{width:40, height:40, borderRadius:'50%', background:'var(--acbg)', display:'flex', alignItems:'center', justifyContent:'center', fontWeight:800, color:'var(--ac)', fontSize:16, flexShrink:0}}>
                  {(member.full_name||'?')[0].toUpperCase()}
                </div>
                <div style={{flex:1}}>
                  <div style={{fontSize:14, fontWeight:700}}>{member.full_name}</div>
                  <div style={{fontSize:11, color:'var(--mu)'}}>{member.email} · <span style={{color:'var(--ac)'}}>{member.role?.replace(/_/g,' ')}</span></div>
                </div>
                {/* Apply role defaults button */}
                <div style={{display:'flex', gap:6, alignItems:'center'}}>
                  <span style={{fontSize:11, color:'var(--mu)'}}>Apply defaults for:</span>
                  <select onChange={e=>{if(e.target.value)applyRoleDefaults(member.id, e.target.value)}} value=""
                    style={{background:'var(--bg3)', border:'1px solid var(--bd)', borderRadius:6, padding:'4px 8px', color:'var(--tx)', fontSize:11, fontFamily:'inherit', cursor:'pointer'}}>
                    <option value="">Select role...</option>
                    {Object.keys(ROLE_DEFAULTS).map(r=><option key={r} value={r}>{r.replace(/_/g,' ')}</option>)}
                  </select>
                </div>
              </div>

              {/* Permission groups */}
              {PERMISSION_GROUPS.map(group => (
                <div key={group.group} style={{marginBottom:14}}>
                  <div style={{fontSize:11, fontWeight:700, color:'var(--mu)', textTransform:'uppercase', letterSpacing:1, marginBottom:8}}>{group.group}</div>
                  <div style={{display:'flex', flexDirection:'column', gap:6}}>
                    {group.perms.map(perm => {
                      const isOn = getPerms(member.id)[perm.key] !== false &&
                        (getPerms(member.id)[perm.key] === true ||
                         ROLE_DEFAULTS[member.role]?.[perm.key] === true)
                      return (
                        <div key={perm.key} style={{display:'flex', alignItems:'center', gap:12, padding:'8px 12px', borderRadius:8, background:'var(--bg3)', border:'1px solid var(--bd)'}}>
                          <div style={{flex:1}}>
                            <div style={{fontSize:12, fontWeight:600}}>{perm.label}</div>
                            <div style={{fontSize:10, color:'var(--mu)'}}>{perm.desc}</div>
                          </div>
                          <div style={S.toggle(isOn)} onClick={()=>togglePerm(member.id, perm.key)}>
                            <div style={S.dot(isOn)}/>
                          </div>
                        </div>
                      )
                    })}
                  </div>
                </div>
              ))}
            </div>
          ))}

          {/* Save button bottom */}
          {members.length > 0 && (
            <button onClick={savePermissions} disabled={saving}
              style={{width:'100%', padding:'12px', borderRadius:10, background:'var(--ac)', color:'#fff', border:'none', cursor:'pointer', fontSize:14, fontWeight:700, fontFamily:'inherit', marginBottom:20, opacity:saving?0.7:1}}>
              {saving ? '⏳ Saving permissions...' : saved ? '✅ All permissions saved!' : '💾 Save All Permissions'}
            </button>
          )}
        </div>
      </div>
    </>
  )
}
