import { useEffect, useState } from 'react'
import { useRouter } from 'next/router'
import { supabase } from '../../src/lib/supabase'

export default function AdminPage() {
  const router = useRouter()
  const [appUser, setAppUser] = useState<any>(null)
  const [users, setUsers] = useState<any[]>([])
  const [loading, setLoading] = useState(true)
  const [selected, setSelected] = useState<Set<string>>(new Set())
  const [bulkLoading, setBulkLoading] = useState(false)
  const [confirmDelete, setConfirmDelete] = useState<string | null>(null)
  const [search, setSearch] = useState('')
  const [filterRole, setFilterRole] = useState('all')
  const [filterStatus, setFilterStatus] = useState('all')
  const [toast, setToast] = useState<{ msg: string; type: 'success' | 'error' } | null>(null)
  const [togglingId, setTogglingId] = useState<string | null>(null)

  useEffect(() => { checkAuth() }, [])

  async function checkAuth() {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) { router.push('/'); return }
    const { data: au } = await supabase.from('app_users').select('*').eq('id', user.id).single()
    if (!au || !['super_admin', 'account_owner'].includes(au.role)) { router.push('/dashboard'); return }
    setAppUser(au)
    fetchUsers(au)
  }

  async function fetchUsers(au: any) {
    setLoading(true)
    let q = supabase.from('app_users').select('*').order('created_at', { ascending: false })
    if (au.role !== 'super_admin') q = q.eq('company_id', au.company_id)
    const { data } = await q
    setUsers(data || [])
    setLoading(false)
  }

  function showToast(msg: string, type: 'success' | 'error' = 'success') {
    setToast({ msg, type })
    setTimeout(() => setToast(null), 3000)
  }

  async function toggleStatus(userId: string, currentStatus: string) {
    setTogglingId(userId)
    const newStatus = currentStatus === 'active' ? 'disabled' : 'active'
    const { error } = await supabase.from('app_users').update({ status: newStatus }).eq('id', userId)
    setTogglingId(null)
    if (error) { showToast('Failed: ' + error.message, 'error'); return }
    setUsers(prev => prev.map(u => u.id === userId ? { ...u, status: newStatus } : u))
    showToast(newStatus === 'active' ? 'User enabled ✅' : 'User disabled ⏸')
  }

  async function deleteSingle(userId: string) {
    const { error } = await supabase.from('app_users').delete().eq('id', userId)
    if (error) { showToast('Delete failed: ' + error.message, 'error'); setConfirmDelete(null); return }
    setUsers(prev => prev.filter(u => u.id !== userId))
    setSelected(prev => { const n = new Set(prev); n.delete(userId); return n })
    setConfirmDelete(null)
    showToast('User deleted')
  }

  async function bulkAction(action: 'disable' | 'enable' | 'delete') {
    setBulkLoading(true)
    const ids = Array.from(selected)
    if (action === 'delete') {
      const { error } = await supabase.from('app_users').delete().in('id', ids)
      if (error) { showToast('Bulk delete failed', 'error'); setBulkLoading(false); setConfirmDelete(null); return }
      setUsers(prev => prev.filter(u => !ids.includes(u.id)))
    } else {
      const newStatus = action === 'disable' ? 'disabled' : 'active'
      const { error } = await supabase.from('app_users').update({ status: newStatus }).in('id', ids)
      if (error) { showToast('Bulk update failed', 'error'); setBulkLoading(false); return }
      setUsers(prev => prev.map(u => ids.includes(u.id) ? { ...u, status: newStatus } : u))
    }
    setSelected(new Set())
    setConfirmDelete(null)
    setBulkLoading(false)
    showToast(`${ids.length} user(s) updated`)
  }

  function toggleSelect(id: string) {
    setSelected(prev => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n })
  }

  const filtered = users.filter(u => {
    const s = search.toLowerCase()
    const matchSearch = !s || (u.full_name || '').toLowerCase().includes(s) || (u.email || '').toLowerCase().includes(s)
    const matchRole = filterRole === 'all' || u.role === filterRole
    const matchStatus = filterStatus === 'all' || (u.status || 'active') === filterStatus
    return matchSearch && matchRole && matchStatus
  })

  const uniqueRoles = [...new Set(users.map(u => u.role).filter(Boolean))]

  const roleColors: any = {
    super_admin: '#ff6b6b', account_owner: '#ffd60a', team_leader: '#ff9f43',
    team_manager: '#c77dff', sr_recruiter: '#48cae4', recruiter: '#3dd68c',
    bd: '#6c8cff', bd_manager: '#a29bfe', job_seeker: '#b2bec3',
  }

  const S = {
    page: { minHeight: '100vh', background: '#111318', color: '#e8eaf0', fontFamily: "'Outfit',sans-serif" },
    nav: { background: '#0d0f14', borderBottom: '1px solid rgba(255,255,255,0.06)', padding: '12px 24px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', position: 'sticky' as const, top: 0, zIndex: 50 },
    body: { padding: '24px', maxWidth: 1300, margin: '0 auto' },
    card: { background: '#1a1d24', borderRadius: 16, border: '1px solid rgba(255,255,255,0.06)', padding: 20, marginBottom: 16 },
    inp: { background: '#22262f', border: '1px solid rgba(255,255,255,0.08)', borderRadius: 8, padding: '8px 12px', color: '#e8eaf0', fontSize: 13, fontFamily: 'inherit', outline: 'none' },
    btn: (bg: string, col: string) => ({ background: bg, color: col, border: 'none', borderRadius: 8, padding: '7px 14px', fontSize: 12, fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' } as const),
  }

  if (loading) return <div style={{ ...S.page, display: 'flex', alignItems: 'center', justifyContent: 'center' }}><span style={{ color: '#7a7f90' }}>Loading...</span></div>

  return (
    <div style={S.page}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
        *{box-sizing:border-box}
        .rh:hover{background:rgba(255,255,255,0.025)!important}

        /* Toggle */
        .tw{display:flex;align-items:center;gap:8px}
        .tg{position:relative;width:42px;height:24px;flex-shrink:0}
        .tg input{opacity:0;width:0;height:0}
        .sl{position:absolute;cursor:pointer;inset:0;background:rgba(255,80,80,0.25);border-radius:24px;transition:.25s}
        .sl:before{content:'';position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#ff5050;border-radius:50%;transition:.25s}
        .tg input:checked+.sl{background:rgba(61,214,140,0.25)}
        .tg input:checked+.sl:before{transform:translateX(18px);background:#3dd68c}
        .tg input:disabled+.sl{opacity:0.5;cursor:not-allowed}
        .tl{font-size:12px;font-weight:700;min-width:50px}

        /* Delete button */
        .db{background:transparent;border:1px solid rgba(255,80,80,0.3);color:#ff5050;border-radius:8px;padding:5px 14px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s}
        .db:hover{background:rgba(255,80,80,0.15);border-color:#ff5050}

        input[type=checkbox]{accent-color:#6c8cff;width:15px;height:15px;cursor:pointer}
        select option{background:#22262f}
      `}</style>

      {/* Toast */}
      {toast && (
        <div style={{ position: 'fixed', top: 20, right: 20, zIndex: 999, background: toast.type === 'success' ? '#0d2a1a' : '#2a0d0d', border: `1px solid ${toast.type === 'success' ? '#3dd68c' : '#ff5050'}`, color: toast.type === 'success' ? '#3dd68c' : '#ff5050', padding: '12px 20px', borderRadius: 12, fontSize: 13, fontWeight: 600, boxShadow: '0 4px 24px rgba(0,0,0,0.5)' }}>
          {toast.msg}
        </div>
      )}

      {/* Confirm Modal */}
      {confirmDelete && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.75)', zIndex: 200, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
          <div style={{ background: '#1a1d24', border: '1px solid rgba(255,80,80,0.2)', borderRadius: 20, padding: 36, maxWidth: 380, width: '90%', textAlign: 'center' }}>
            <div style={{ fontSize: 44, marginBottom: 12 }}>🗑️</div>
            <div style={{ fontSize: 18, fontWeight: 700, marginBottom: 10 }}>Confirm Delete</div>
            <div style={{ color: '#7a7f90', fontSize: 13, marginBottom: 6, lineHeight: 1.6 }}>
              {confirmDelete === 'bulk' ? `Delete ${selected.size} selected user(s)?` : 'Delete this user?'}
            </div>
            <div style={{ color: '#ff5050', fontSize: 12, marginBottom: 28 }}>This cannot be undone.</div>
            <div style={{ display: 'flex', gap: 12, justifyContent: 'center' }}>
              <button style={S.btn('rgba(255,255,255,0.06)', '#7a7f90')} onClick={() => setConfirmDelete(null)}>Cancel</button>
              <button style={S.btn('#ff3333', '#fff')} onClick={() => {
                if (confirmDelete === 'bulk') bulkAction('delete')
                else deleteSingle(confirmDelete.replace('single:', ''))
              }}>{bulkLoading ? 'Deleting...' : 'Yes, Delete'}</button>
            </div>
          </div>
        </div>
      )}

      {/* Nav */}
      <nav style={S.nav}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 12, cursor: 'pointer' }} onClick={() => router.push('/dashboard')}>
          <div style={{ width: 30, height: 30, borderRadius: 8, background: 'rgba(108,140,255,0.2)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontWeight: 'bold', color: '#6c8cff', fontSize: 14 }}>R</div>
          <div>
            <div style={{ fontWeight: 700, fontSize: 15, lineHeight: 1.2 }}>RecruitBase Pro</div>
            <div style={{ fontSize: 9, color: '#505468', letterSpacing: '1.5px', textTransform: 'uppercase' }}>Recruitment OS</div>
          </div>
          <span style={{ fontSize: 12, padding: '2px 10px', borderRadius: 20, background: 'rgba(255,215,10,0.1)', color: '#ffd60a' }}>👑 Admin</span>
        </div>
        <button style={S.btn('rgba(108,140,255,0.1)', '#6c8cff')} onClick={() => router.push('/dashboard')}>← Dashboard</button>
      </nav>

      <div style={S.body}>
        <div style={{ marginBottom: 20 }}>
          <div style={{ fontSize: 22, fontWeight: 700 }}>Team Management</div>
          <div style={{ color: '#7a7f90', fontSize: 13, marginTop: 4 }}>
            {users.length} total · <span style={{ color: '#3dd68c' }}>{users.filter(u => (u.status || 'active') === 'active').length} active</span> · <span style={{ color: '#ff5050' }}>{users.filter(u => u.status === 'disabled').length} disabled</span>
          </div>
        </div>

        {/* Filters */}
        <div style={{ ...S.card, padding: '14px 16px' }}>
          <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap' as const, alignItems: 'center' }}>
            <input style={{ ...S.inp, flex: 1, minWidth: 180 }} placeholder="🔍  Search name or email..." value={search} onChange={e => setSearch(e.target.value)} />
            <select style={S.inp} value={filterRole} onChange={e => setFilterRole(e.target.value)}>
              <option value="all">All Roles</option>
              {uniqueRoles.map(r => <option key={r as string} value={r as string}>{(r as string).replace(/_/g, ' ')}</option>)}
            </select>
            <select style={S.inp} value={filterStatus} onChange={e => setFilterStatus(e.target.value)}>
              <option value="all">All Status</option>
              <option value="active">Active</option>
              <option value="disabled">Disabled</option>
            </select>
            <span style={{ color: '#505468', fontSize: 12 }}>{filtered.length} result{filtered.length !== 1 ? 's' : ''}</span>
          </div>
        </div>

        {/* Bulk Bar */}
        {selected.size > 0 && (
          <div style={{ background: 'rgba(108,140,255,0.08)', border: '1px solid rgba(108,140,255,0.2)', borderRadius: 12, padding: '10px 16px', marginBottom: 14, display: 'flex', alignItems: 'center', gap: 10, flexWrap: 'wrap' as const }}>
            <span style={{ color: '#6c8cff', fontWeight: 700 }}>✓ {selected.size} selected</span>
            <div style={{ flex: 1 }} />
            <button style={S.btn('rgba(61,214,140,0.15)', '#3dd68c')} onClick={() => bulkAction('enable')} disabled={bulkLoading}>✅ Enable Selected</button>
            <button style={S.btn('rgba(255,159,67,0.15)', '#ff9f43')} onClick={() => bulkAction('disable')} disabled={bulkLoading}>⏸ Disable Selected</button>
            <button className="db" onClick={() => setConfirmDelete('bulk')} disabled={bulkLoading}>🗑️ Delete Selected</button>
            <button style={S.btn('rgba(255,255,255,0.05)', '#505468')} onClick={() => setSelected(new Set())}>✕ Clear</button>
          </div>
        )}

        {/* Table */}
        <div style={S.card}>
          <div style={{ overflowX: 'auto' as const }}>
            <table style={{ width: '100%', borderCollapse: 'collapse' as const, fontSize: 13 }}>
              <thead>
                <tr style={{ borderBottom: '1px solid rgba(255,255,255,0.07)' }}>
                  <th style={{ padding: '10px 14px', width: 44 }}>
                    <input type="checkbox"
                      checked={filtered.length > 0 && filtered.filter(u => u.id !== appUser?.id).every(u => selected.has(u.id))}
                      onChange={() => {
                        const sel = filtered.filter(u => u.id !== appUser?.id).map(u => u.id)
                        const allSel = sel.every(id => selected.has(id))
                        setSelected(allSel ? new Set() : new Set(sel))
                      }} />
                  </th>
                  {['Name', 'Email', 'Role', 'Active / Disable', 'Points', 'Joined', 'Delete'].map(h => (
                    <th key={h} style={{ textAlign: 'left', padding: '10px 14px', fontSize: 10, color: '#505468', fontWeight: 700, textTransform: 'uppercase' as const, letterSpacing: '0.8px', whiteSpace: 'nowrap' as const }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {filtered.length === 0 && (
                  <tr><td colSpan={8} style={{ textAlign: 'center', padding: 48, color: '#505468' }}>No users found</td></tr>
                )}
                {filtered.map(u => {
                  const isDisabled = u.status === 'disabled'
                  const isMe = appUser?.id === u.id
                  const isToggling = togglingId === u.id
                  return (
                    <tr key={u.id} className="rh" style={{ borderBottom: '1px solid rgba(255,255,255,0.04)', opacity: isDisabled ? 0.6 : 1 }}>
                      <td style={{ padding: '12px 14px' }}>
                        {!isMe && <input type="checkbox" checked={selected.has(u.id)} onChange={() => toggleSelect(u.id)} />}
                      </td>
                      <td style={{ padding: '12px 14px', fontWeight: 600, whiteSpace: 'nowrap' as const }}>
                        {u.full_name || '—'}
                        {isMe && <span style={{ fontSize: 10, background: 'rgba(108,140,255,0.2)', color: '#6c8cff', padding: '1px 7px', borderRadius: 4, marginLeft: 6 }}>You</span>}
                      </td>
                      <td style={{ padding: '12px 14px', color: '#7a7f90', fontSize: 12 }}>{u.email}</td>
                      <td style={{ padding: '12px 14px' }}>
                        <span style={{ fontSize: 11, background: `${roleColors[u.role] || '#7a7f90'}22`, color: roleColors[u.role] || '#7a7f90', padding: '3px 9px', borderRadius: 5, fontWeight: 600, textTransform: 'capitalize' as const, whiteSpace: 'nowrap' as const }}>
                          {(u.role || '').replace(/_/g, ' ')}
                        </span>
                      </td>

                      {/* Toggle Switch Column */}
                      <td style={{ padding: '12px 14px' }}>
                        {isMe ? (
                          <span style={{ fontSize: 12, color: '#3dd68c', fontWeight: 600 }}>● Always On</span>
                        ) : (
                          <div className="tw">
                            <label className="tg">
                              <input type="checkbox" checked={!isDisabled} disabled={isToggling} onChange={() => toggleStatus(u.id, u.status || 'active')} />
                              <span className="sl" />
                            </label>
                            <span className="tl" style={{ color: isDisabled ? '#ff5050' : '#3dd68c' }}>
                              {isToggling ? '...' : isDisabled ? 'Off' : 'On'}
                            </span>
                          </div>
                        )}
                      </td>

                      <td style={{ padding: '12px 14px', color: '#ffd60a', fontWeight: 700 }}>{u.points || 0}</td>
                      <td style={{ padding: '12px 14px', color: '#505468', fontSize: 12, whiteSpace: 'nowrap' as const }}>
                        {u.created_at ? new Date(u.created_at).toLocaleDateString('en-IN') : '—'}
                      </td>
                      <td style={{ padding: '12px 14px' }}>
                        {!isMe && <button className="db" onClick={() => setConfirmDelete(`single:${u.id}`)}>🗑️ Delete</button>}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  )
}
