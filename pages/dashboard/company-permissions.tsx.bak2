import { useEffect, useState } from 'react'
import Layout from '../../src/components/Layout';
import { useRouter } from 'next/router'
import { supabase } from '../../src/lib/supabase'

const PERMISSION_GROUPS = [
  {
    group: 'Candidate Management',
    icon: '👥',
    perms: [
      { key: 'can_add_profiles', label: 'Add new candidate profiles', roles: ['recruiter','sr_recruiter','team_leader'] },
      { key: 'can_edit_profiles', label: 'Edit candidate profiles', roles: ['recruiter','sr_recruiter','team_leader'] },
      { key: 'can_delete_profiles', label: 'Delete candidate profiles', roles: ['sr_recruiter','team_leader'] },
      { key: 'can_reveal_contacts', label: 'View contact details (mobile/email)', roles: ['recruiter','sr_recruiter'] },
      { key: 'can_export_profiles', label: 'Export candidate data', roles: ['sr_recruiter','team_leader'] },
      { key: 'can_bulk_message', label: 'Send bulk WhatsApp/Email messages', roles: ['recruiter','sr_recruiter'] },
    ]
  },
  {
    group: 'Jobs & BD',
    icon: '💼',
    perms: [
      { key: 'can_add_jd', label: 'Create new Job Descriptions', roles: ['sr_recruiter','team_leader'] },
      { key: 'can_edit_jd', label: 'Edit Job Descriptions', roles: ['sr_recruiter','team_leader'] },
      { key: 'can_delete_jd', label: 'Delete Job Descriptions', roles: ['team_leader'] },
      { key: 'can_access_bd', label: 'Access BD Pipeline', roles: ['bd','bd_manager'] },
      { key: 'can_add_bd', label: 'Add BD / client entries', roles: ['bd','bd_manager'] },
    ]
  },
  {
    group: 'Interviews & Scheduling',
    icon: '📅',
    perms: [
      { key: 'can_schedule_interviews', label: 'Schedule interviews', roles: ['recruiter','sr_recruiter'] },
      { key: 'can_edit_interviews', label: 'Edit/cancel interviews', roles: ['sr_recruiter','team_leader'] },
      { key: 'can_view_all_interviews', label: 'View all team interviews', roles: ['team_leader','team_manager'] },
    ]
  },
  {
    group: 'Data & Reports',
    icon: '📊',
    perms: [
      { key: 'can_view_analytics', label: 'View analytics & reports', roles: ['sr_recruiter','team_leader','team_manager'] },
      { key: 'can_export_reports', label: 'Export reports (CSV/PDF)', roles: ['team_leader','team_manager'] },
      { key: 'can_view_team_data', label: "View other team members' profiles", roles: ['sr_recruiter','team_leader'] },
    ]
  },
  {
    group: 'Team & Settings',
    icon: '⚙️',
    perms: [
      { key: 'can_invite_members', label: 'Invite new team members', roles: ['team_leader','team_manager'] },
      { key: 'can_change_roles', label: 'Change team member roles', roles: ['team_manager'] },
      { key: 'can_manage_templates', label: 'Create/edit message templates', roles: ['sr_recruiter','team_leader'] },
    ]
  },
]

const ALL_ROLES = ['recruiter','sr_recruiter','team_leader','team_manager','bd','bd_manager']
const ROLE_LABELS: any = {
  recruiter: 'Recruiter', sr_recruiter: 'Sr. Recruiter',
  team_leader: 'Team Leader', team_manager: 'Team Manager',
  bd: 'BD Executive', bd_manager: 'BD Manager'
}

export default function CompanyPermissionsPage() {
  const router = useRouter()
  const [appUser, setAppUser] = useState<any>(null)
  const [company, setCompany] = useState<any>(null)
  const [permissions, setPermissions] = useState<any>({})
  const [defaultRole, setDefaultRole] = useState('recruiter')
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState<string|null>(null)
  const [toast, setToast] = useState<{msg:string,type:'success'|'error'}|null>(null)
  const [activeGroup, setActiveGroup] = useState('Candidate Management')

  useEffect(() => { checkAuth() }, [])

  async function checkAuth() {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) { router.push('/'); return }
    const { data: au } = await supabase.from('app_users').select('*').eq('id', user.id).single()
    if (!au || !['super_admin','account_owner'].includes(au.role)) { router.push('/dashboard'); return }
    setAppUser(au)
    if (au.company_id) {
      const { data: co } = await supabase.from('companies').select('*').eq('id', au.company_id).single()
      setCompany(co)
      if (co?.default_role) setDefaultRole(co.default_role)
    }
    await loadPermissions(au.company_id)
    setLoading(false)
  }

  async function loadPermissions(companyId: string) {
    const { data } = await supabase.from('company_permissions').select('*').eq('company_id', companyId)
    const map: any = {}
    const allKeys = PERMISSION_GROUPS.flatMap(g => g.perms.map(p => p.key))
    allKeys.forEach(k => { map[k] = true })
    ;(data || []).forEach((p: any) => { map[p.permission_key] = p.is_enabled })
    setPermissions(map)
  }

  function showToast(msg: string, type: 'success'|'error' = 'success') {
    setToast({ msg, type })
    setTimeout(() => setToast(null), 2500)
  }

  async function togglePermission(key: string) {
    if (!appUser?.company_id) return
    const newVal = !permissions[key]
    setSaving(key)
    setPermissions((prev: any) => ({ ...prev, [key]: newVal }))
    const { error } = await supabase.from('company_permissions').upsert({
      company_id: appUser.company_id,
      permission_key: key,
      is_enabled: newVal,
      updated_by: appUser.id,
      updated_at: new Date().toISOString()
    }, { onConflict: 'company_id,permission_key' })
    setSaving(null)
    if (error) { showToast('Failed to save', 'error'); setPermissions((prev: any) => ({ ...prev, [key]: !newVal })) }
    else showToast(newVal ? 'Permission enabled' : 'Permission disabled')
  }

  async function saveDefaultRole(role: string) {
    setDefaultRole(role)
    await supabase.from('companies').update({ default_role: role }).eq('id', appUser.company_id)
    showToast('Default role updated')
  }

  async function setAllInGroup(groupName: string, value: boolean) {
    const group = PERMISSION_GROUPS.find(g => g.group === groupName)
    if (!group || !appUser?.company_id) return
    const updates = group.perms.map(p => ({
      company_id: appUser.company_id,
      permission_key: p.key,
      is_enabled: value,
      updated_by: appUser.id,
      updated_at: new Date().toISOString()
    }))
    const newPerms = { ...permissions }
    group.perms.forEach(p => { newPerms[p.key] = value })
    setPermissions(newPerms)
    await supabase.from('company_permissions').upsert(updates, { onConflict: 'company_id,permission_key' })
    showToast(`All ${groupName} permissions ${value ? 'enabled' : 'disabled'}`)
  }

  const S = {
    page: { minHeight: '100vh', background: '#111318', color: '#e8eaf0', fontFamily: "'Outfit',sans-serif" },
    nav: { background: '#0d0f14', borderBottom: '1px solid rgba(255,255,255,0.06)', padding: '12px 24px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', position: 'sticky' as const, top: 0, zIndex: 50 },
    body: { padding: '24px', maxWidth: 1000, margin: '0 auto' },
    card: { background: '#1a1d24', borderRadius: 14, border: '1px solid rgba(255,255,255,0.06)', padding: 20, marginBottom: 16 },
    inp: { background: '#22262f', border: '1px solid rgba(255,255,255,0.08)', borderRadius: 8, padding: '8px 12px', color: '#e8eaf0', fontSize: 13, fontFamily: 'inherit', outline: 'none' },
    btn: (bg: string, col: string) => ({ background: bg, color: col, border: 'none', borderRadius: 8, padding: '7px 14px', fontSize: 12, fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' } as const),
  }

  if (loading) return <div style={{ ...S.page, display: 'flex', alignItems: 'center', justifyContent: 'center' }}><div style={{ color: '#7a7f90' }}>Loading...</div></div>

  const currentGroup = PERMISSION_GROUPS.find(g => g.group === activeGroup)!

  return (
    <Layout>
    <div style={S.page}>
      
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
        *{box-sizing:border-box}
        select option{background:#22262f}
        .tog{position:relative;width:46px;height:26px;flex-shrink:0;cursor:pointer}
        .tog input{opacity:0;width:0;height:0}
        .sl{position:absolute;inset:0;border-radius:26px;transition:.25s;cursor:pointer}
        .sl:before{content:'';position:absolute;height:20px;width:20px;left:3px;bottom:3px;border-radius:50%;transition:.25s}
        .tog input:checked+.sl{background:rgba(61,214,140,0.25)}
        .tog input:checked+.sl:before{transform:translateX(20px);background:#3dd68c}
        .tog input:not(:checked)+.sl{background:rgba(255,80,80,0.2)}
        .tog input:not(:checked)+.sl:before{background:#ff5050}
        .tog input:disabled+.sl{opacity:0.5;cursor:not-allowed}
        .prow:hover{background:rgba(255,255,255,0.02);border-radius:10px}
        .grp-btn{padding:8px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.07);background:transparent;color:#7a7f90;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit;transition:all .15s;white-space:nowrap}
        .grp-btn.on{background:rgba(108,140,255,0.15);color:#6c8cff;border-color:rgba(108,140,255,0.3)}
      `}</style>

      {toast && (
        <div style={{ position: 'fixed', top: 20, right: 20, zIndex: 999, background: toast.type === 'success' ? '#0d2a1a' : '#2a0d0d', border: `1px solid ${toast.type === 'success' ? '#3dd68c' : '#ff5050'}`, color: toast.type === 'success' ? '#3dd68c' : '#ff5050', padding: '12px 20px', borderRadius: 12, fontSize: 13, fontWeight: 600 }}>{toast.msg}</div>
      )}

      <nav style={S.nav}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
          <div style={{ width: 30, height: 30, borderRadius: 8, background: 'rgba(108,140,255,0.2)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontWeight: 'bold', color: '#6c8cff', fontSize: 14 }}>R</div>
          <div>
            <div style={{ fontWeight: 700, fontSize: 15, lineHeight: 1.2 }}>RecruitBase Pro</div>
            <div style={{ fontSize: 9, color: '#505468', letterSpacing: '1.5px', textTransform: 'uppercase' }}>Recruitment OS</div>
          </div>
          <span style={{ fontSize: 12, padding: '2px 10px', borderRadius: 20, background: 'rgba(255,215,10,0.1)', color: '#ffd60a' }}>⚙️ Permissions</span>
        </div>
        
      </nav>

      <div style={S.body}>
        <div style={{ marginBottom: 20 }}>
          <div style={{ fontSize: 22, fontWeight: 700 }}>Team Permissions</div>
          <div style={{ color: '#7a7f90', fontSize: 13, marginTop: 4 }}>
            {company?.name} — Control what each role can do
          </div>
        </div>

        {/* Default role + global settings */}
        <div style={S.card}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 16, flexWrap: 'wrap' as const }}>
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 13, fontWeight: 600, marginBottom: 4 }}>Default role for new members</div>
              <div style={{ fontSize: 12, color: '#7a7f90' }}>When someone joins via company code, assign this role automatically</div>
            </div>
            <select value={defaultRole} onChange={e => saveDefaultRole(e.target.value)} style={{ ...S.inp, minWidth: 160 }}>
              {ALL_ROLES.map(r => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}
            </select>
          </div>
        </div>

        {/* Group tabs */}
        <div style={{ display: 'flex', gap: 8, marginBottom: 16, flexWrap: 'wrap' as const }}>
          {PERMISSION_GROUPS.map(g => (
            <button key={g.group} className={`grp-btn${activeGroup === g.group ? ' on' : ''}`} onClick={() => setActiveGroup(g.group)}>
              {g.icon} {g.group}
            </button>
          ))}
        </div>

        {/* Permission rows */}
        <div style={S.card}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
            <div style={{ fontSize: 14, fontWeight: 700 }}>{currentGroup.icon} {currentGroup.group}</div>
            <div style={{ display: 'flex', gap: 8 }}>
              <button style={S.btn('rgba(61,214,140,0.12)', '#3dd68c')} onClick={() => setAllInGroup(activeGroup, true)}>Enable All</button>
              <button style={S.btn('rgba(255,80,80,0.1)', '#ff5050')} onClick={() => setAllInGroup(activeGroup, false)}>Disable All</button>
            </div>
          </div>

          {currentGroup.perms.map(p => (
            <div key={p.key} className="prow" style={{ display: 'flex', alignItems: 'center', gap: 14, padding: '12px 8px', borderBottom: '1px solid rgba(255,255,255,0.04)' }}>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 13, fontWeight: 500 }}>{p.label}</div>
                <div style={{ fontSize: 11, color: '#505468', marginTop: 3 }}>
                  Applies to: {p.roles.map(r => (
                    <span key={r} style={{ background: 'rgba(108,140,255,0.1)', color: '#6c8cff', borderRadius: 4, padding: '1px 6px', marginRight: 4, fontSize: 10 }}>{ROLE_LABELS[r] || r}</span>
                  ))}
                </div>
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: permissions[p.key] ? '#3dd68c' : '#ff5050', minWidth: 44, textAlign: 'right' as const }}>
                  {saving === p.key ? '...' : permissions[p.key] ? 'ON' : 'OFF'}
                </span>
                <label className="tog">
                  <input type="checkbox" checked={!!permissions[p.key]} disabled={saving === p.key} onChange={() => togglePermission(p.key)} />
                  <span className="sl" />
                </label>
              </div>
            </div>
          ))}
        </div>

        {/* Role summary */}
        <div style={S.card}>
          <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 14 }}>Role Permission Summary</div>
          <div style={{ overflowX: 'auto' as const }}>
            <table style={{ width: '100%', borderCollapse: 'collapse' as const, fontSize: 12 }}>
              <thead>
                <tr style={{ borderBottom: '1px solid rgba(255,255,255,0.07)' }}>
                  <th style={{ textAlign: 'left', padding: '8px 10px', color: '#505468', fontSize: 10, fontWeight: 700, textTransform: 'uppercase' as const }}>Permission</th>
                  {ALL_ROLES.map(r => (
                    <th key={r} style={{ padding: '8px 10px', color: '#505468', fontSize: 10, fontWeight: 700, textTransform: 'uppercase' as const, whiteSpace: 'nowrap' as const }}>{ROLE_LABELS[r]}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {PERMISSION_GROUPS.flatMap(g => g.perms).map(p => (
                  <tr key={p.key} style={{ borderBottom: '1px solid rgba(255,255,255,0.03)' }}>
                    <td style={{ padding: '7px 10px', color: '#7a7f90' }}>{p.label}</td>
                    {ALL_ROLES.map(r => (
                      <td key={r} style={{ padding: '7px 10px', textAlign: 'center' as const }}>
                        {p.roles.includes(r) && permissions[p.key]
                          ? <span style={{ color: '#3dd68c', fontSize: 14 }}>✓</span>
                          : p.roles.includes(r) && !permissions[p.key]
                            ? <span style={{ color: '#ff5050', fontSize: 14 }}>✗</span>
                            : <span style={{ color: '#2a2d35', fontSize: 12 }}>—</span>
                        }
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    </Layout>
  )
}
