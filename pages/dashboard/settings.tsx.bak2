import { useEffect, useState } from 'react'
import Layout from '../../src/components/Layout';
import { useRouter } from 'next/router'
import { supabase } from '../../src/lib/supabase'

export default function Settings() {
  const router = useRouter()
  const [user, setUser] = useState<any>(null)
  const [appUser, setAppUser] = useState<any>(null)
  const [form, setForm] = useState({ full_name:'', title:'', phone:'' })
  const [saved, setSaved] = useState(false)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (!session) { router.push('/'); return }
      setUser(session.user)
      loadUser(session.user.id)
    })
  }, [router])

  async function loadUser(id: string) {
    const { data } = await supabase.from('app_users').select('*').eq('id', id).single()
    if (data) { setAppUser(data); setForm({ full_name: data.full_name||'', title: data.title||'', phone: data.phone||'' }) }
    setLoading(false)
  }

  async function saveSettings() {
    const { error } = await supabase.from('app_users').update(form).eq('id', user.id)
    if (!error) { setSaved(true); setTimeout(() => setSaved(false), 2000) }
  }

  async function signOut() { await supabase.auth.signOut(); router.push('/') }

  const IS: any = { width:'100%', background:'var(--bg3)', border:'1px solid rgba(255,255,255,0.1)', borderRadius:8, padding:'10px 12px', color:'var(--tx)', fontSize:13, outline:'none', fontFamily:'inherit', boxSizing:'border-box' }
  const LS: any = { display:'block', fontSize:10, fontWeight:600, color:'var(--mu)', textTransform:'uppercase', letterSpacing:1, marginBottom:6 }

  if (loading) return <div style={{minHeight:'100vh',display:'flex',alignItems:'center',justifyContent:'center',background:'var(--bg)',color:'var(--tx)'}}>Loading...</div>

  return (
    <Layout>
    <div style={{minHeight:'100vh',background:'var(--bg)',color:'var(--tx)',fontFamily:'Outfit,Inter,sans-serif'}}>
      
      <style>{`@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');*{box-sizing:border-box}`}</style>
      <nav style={{background:'var(--nb)',borderBottom:'1px solid rgba(255,255,255,0.06)',padding:'12px 24px',display:'flex',alignItems:'center',justifyContent:'space-between',position:'sticky',top:0,zIndex:50}}>
        <div style={{display:'flex',alignItems:'center',gap:12}}>
          <div style={{width:30,height:30,borderRadius:8,background:'rgba(108,140,255,0.2)',display:'flex',alignItems:'center',justifyContent:'center',fontWeight:'bold',color:'#6c8cff',fontSize:14}}>R</div>
          <span style={{fontWeight:700,fontSize:15}}>RecruitBase Pro</span>
        </div>
        <div style={{display:'flex',gap:10}}>
          
          <button onClick={signOut} style={{fontSize:12,padding:'6px 14px',borderRadius:8,background:'rgba(255,107,107,0.1)',color:'#ff6b6b',border:'1px solid rgba(255,107,107,0.3)',cursor:'pointer',fontFamily:'inherit'}}>Sign out</button>
        </div>
      </nav>

      <div style={{maxWidth:600,margin:'40px auto',padding:'0 24px'}}>
        <h1 style={{fontSize:22,fontWeight:700,marginBottom:4}}>⚙ My Settings</h1>
        <p style={{fontSize:13,color:'var(--mu)',marginBottom:32}}>Manage your profile and preferences</p>

        {/* Profile Info */}
        <div style={{background:'var(--bg2)',border:'1px solid rgba(255,255,255,0.07)',borderRadius:14,padding:24,marginBottom:20}}>
          <div style={{fontSize:13,fontWeight:700,color:'#6c8cff',marginBottom:20}}>Profile Information</div>
          
          {/* Avatar */}
          <div style={{display:'flex',alignItems:'center',gap:16,marginBottom:24,padding:16,background:'var(--bg3)',borderRadius:10}}>
            <img src={user?.user_metadata?.avatar_url||''} alt="" style={{width:56,height:56,borderRadius:'50%',background:'#333'}}
              onError={e=>{(e.target as any).style.display='none'}}/>
            <div>
              <div style={{fontWeight:600,fontSize:15}}>{appUser?.full_name}</div>
              <div style={{fontSize:12,color:'var(--mu)'}}>{user?.email}</div>
              <div style={{fontSize:11,padding:'2px 8px',borderRadius:20,background:'rgba(108,140,255,0.1)',color:'#6c8cff',display:'inline-block',marginTop:4}}>{appUser?.role}</div>
            </div>
          </div>

          <div style={{display:'grid',gap:14}}>
            <div>
              <label style={LS}>Display Name</label>
              <input style={IS} value={form.full_name} onChange={e=>setForm(f=>({...f,full_name:e.target.value}))} placeholder="Your full name"/>
            </div>
            <div>
              <label style={LS}>Job Title</label>
              <input style={IS} value={form.title} onChange={e=>setForm(f=>({...f,title:e.target.value}))} placeholder="e.g. Senior Recruiter"/>
            </div>
            <div>
              <label style={LS}>Phone Number</label>
              <input style={IS} value={form.phone} onChange={e=>setForm(f=>({...f,phone:e.target.value}))} placeholder="Your contact number"/>
            </div>
          </div>
          <button onClick={saveSettings} style={{marginTop:16,padding:'10px 24px',borderRadius:10,background:'#6c8cff',color:'#fff',border:'none',cursor:'pointer',fontSize:13,fontWeight:600,fontFamily:'inherit'}}>
            {saved ? '✓ Saved!' : 'Save Changes'}
          </button>
        </div>

        {/* Account Info */}
        <div style={{background:'var(--bg2)',border:'1px solid rgba(255,255,255,0.07)',borderRadius:14,padding:24,marginBottom:20}}>
          <div style={{fontSize:13,fontWeight:700,color:'#6c8cff',marginBottom:16}}>Account Information</div>
          {[
            ['Email', user?.email],
            ['Role', appUser?.role],
            ['Points', appUser?.points + ' pts'],
            ['Member since', new Date(appUser?.created_at||Date.now()).toLocaleDateString('en-IN')],
          ].map(([k,v])=>(
            <div key={k} style={{display:'flex',justifyContent:'space-between',padding:'10px 0',borderBottom:'1px solid rgba(255,255,255,0.05)',fontSize:13}}>
              <span style={{color:'var(--mu)'}}>{k}</span>
              <span style={{color:'var(--tx)',fontWeight:500}}>{v}</span>
            </div>
          ))}
        </div>

        {/* Legal */}
        <div style={{background:'var(--bg2)',border:'1px solid rgba(255,255,255,0.07)',borderRadius:14,padding:24}}>
          <div style={{fontSize:13,fontWeight:700,color:'#6c8cff',marginBottom:16}}>Legal</div>
          <div style={{display:'flex',gap:12}}>
            <button onClick={()=>router.push('/privacy')} style={{padding:'8px 16px',borderRadius:8,background:'rgba(255,255,255,0.05)',color:'var(--mu)',border:'1px solid rgba(255,255,255,0.1)',cursor:'pointer',fontFamily:'inherit',fontSize:13}}>Privacy Policy</button>
            <button onClick={()=>router.push('/terms')} style={{padding:'8px 16px',borderRadius:8,background:'rgba(255,255,255,0.05)',color:'var(--mu)',border:'1px solid rgba(255,255,255,0.1)',cursor:'pointer',fontFamily:'inherit',fontSize:13}}>Terms of Service</button>
          </div>
        </div>
      </div>
    </div>
    </Layout>
  )
}
