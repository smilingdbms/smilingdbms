import { useEffect, useState } from 'react'
import { useRouter } from 'next/router'
import { supabase } from '../../src/lib/supabase'
import { applyTheme, getSavedTheme } from '../../src/lib/theme'

const APP_STATUSES = ['Applied','Shortlisted','Interview Scheduled','Selected','Rejected','On Hold','Offer Made']
const STATUS_C: any = {
  'Applied':'#7ab3ff','Shortlisted':'#3dd68c','Interview Scheduled':'#48cae4',
  'Selected':'#ffd60a','Rejected':'#ff6b6b','On Hold':'#ffb347','Offer Made':'#c77dff'
}

export default function Applications() {
  const router = useRouter()
  const [appUser, setAppUser] = useState<any>(null)
  const [applications, setApplications] = useState<any[]>([])
  const [loading, setLoading] = useState(true)
  const [search, setSearch] = useState('')
  const [filterStatus, setFilterStatus] = useState('All')
  const [filterJob, setFilterJob] = useState('All')
  const [jobs, setJobs] = useState<any[]>([])

  useEffect(() => {
    applyTheme(getSavedTheme())
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (!session) { router.push('/'); return }
      loadData(session.user)
    })
  }, [router])

  async function loadData(u: any) {
    const { data: au } = await supabase.from('app_users').select('*').eq('id', u.id).single()
    setAppUser(au)
    const { data: apps } = await supabase.from('job_applications')
      .select('*, job:job_descriptions(title,company,location), applicant:app_users!job_applications_applicant_id_fkey(full_name,email)')
      .order('created_at', { ascending: false })
    const { data: js } = await supabase.from('job_descriptions').select('id,title,company').order('title')
    setApplications(apps || [])
    setJobs(js || [])
    setLoading(false)
  }

  async function updateStatus(id: string, status: string) {
    await supabase.from('job_applications').update({ status, reviewed_by: appUser?.id }).eq('id', id)
    setApplications(prev => prev.map(a => a.id === id ? { ...a, status } : a))
    // Notify applicant
    const app = applications.find(a => a.id === id)
    if (app?.applicant_id) {
      await supabase.from('notifications').insert({
        user_id: app.applicant_id,
        from_user_id: appUser?.id,
        type: 'status_update',
        title: `Application Update: ${status}`,
        message: `Your application for ${app.job?.title} at ${app.job?.company} has been updated to "${status}"`,
        is_read: false
      }).catch(() => {})
    }
  }

  async function updateNotes(id: string, notes: string) {
    await supabase.from('job_applications').update({ notes }).eq('id', id)
    setApplications(prev => prev.map(a => a.id === id ? { ...a, notes } : a))
  }

  const filtered = applications.filter(a => {
    const matchSearch = !search || a.full_name?.toLowerCase().includes(search.toLowerCase()) || a.email?.toLowerCase().includes(search.toLowerCase()) || a.job?.title?.toLowerCase().includes(search.toLowerCase())
    const matchStatus = filterStatus === 'All' || a.status === filterStatus
    const matchJob = filterJob === 'All' || a.job_id === filterJob
    return matchSearch && matchStatus && matchJob
  })

  const S: any = {
    page: { minHeight: '100vh', background: 'var(--bg)', color: 'var(--tx)', fontFamily: 'Outfit,sans-serif' },
    card: { background: 'var(--bg2)', border: '1px solid var(--bd)', borderRadius: 12, padding: 20 },
    inp: { background: 'var(--bg3)', border: '1px solid var(--bd)', borderRadius: 8, padding: '8px 12px', fontSize: 13, color: 'var(--tx)', outline: 'none', fontFamily: 'Outfit,sans-serif' },
  }

  if (loading) return <div style={{ minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center', background: 'var(--bg)', color: 'var(--tx)', fontFamily: 'Outfit,sans-serif' }}>Loading Applications...</div>

  return (
    <div style={S.page}>
      <style>{`@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap');*{box-sizing:border-box}select option{background:var(--bg3)}`}</style>

      <nav style={{ background: 'var(--nb)', borderBottom: '1px solid var(--nbr)', padding: '12px 24px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', position: 'sticky' as any, top: 0, zIndex: 50 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 12, cursor: 'pointer' }} onClick={() => router.push('/dashboard')}>
          <div style={{ width: 30, height: 30, borderRadius: 8, background: 'var(--acbg)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontWeight: 700, color: 'var(--ac)', fontSize: 14 }}>R</div>
          <div>
            <div style={{ fontWeight: 700, fontSize: 15 }}>RecruitBase Pro</div>
            <div style={{ fontSize: 9, color: 'var(--mu)', letterSpacing: '1.5px', textTransform: 'uppercase' }}>Recruitment OS</div>
          </div>
          <span style={{ fontSize: 12, padding: '2px 10px', borderRadius: 20, background: 'var(--acbg)', color: 'var(--ac)' }}>📨 Applications</span>
        </div>
        <button onClick={() => router.push('/dashboard')} style={{ background: 'var(--bg3)', color: 'var(--tx)', border: 'none', borderRadius: 7, padding: '7px 14px', fontSize: 12, cursor: 'pointer' }}>← Dashboard</button>
      </nav>

      <div style={{ maxWidth: 1300, margin: '0 auto', padding: '24px 20px' }}>

        {/* STATS */}
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(130px,1fr))', gap: 12, marginBottom: 20 }}>
          {[
            { l: 'Total', v: applications.length, c: 'var(--ac)' },
            { l: 'New', v: applications.filter(a => a.status === 'Applied').length, c: '#7ab3ff' },
            { l: 'Shortlisted', v: applications.filter(a => a.status === 'Shortlisted').length, c: 'var(--gn)' },
            { l: 'Interview', v: applications.filter(a => a.status === 'Interview Scheduled').length, c: '#48cae4' },
            { l: 'Selected', v: applications.filter(a => a.status === 'Selected').length, c: 'var(--gd)' },
            { l: 'Rejected', v: applications.filter(a => a.status === 'Rejected').length, c: 'var(--rd)' },
          ].map(s => (
            <div key={s.l} style={{ ...S.card, textAlign: 'center', padding: 14 }}>
              <div style={{ fontSize: 22, fontWeight: 700, color: s.c }}>{s.v}</div>
              <div style={{ fontSize: 10, color: 'var(--mu)', marginTop: 2 }}>{s.l}</div>
            </div>
          ))}
        </div>

        {/* FILTERS */}
        <div style={{ display: 'flex', gap: 10, marginBottom: 16, flexWrap: 'wrap' as any }}>
          <input value={search} onChange={e => setSearch(e.target.value)} placeholder="🔍 Search applicant or job..." style={{ ...S.inp, flex: 1, minWidth: 200, width: 'auto' }} />
          <select value={filterStatus} onChange={e => setFilterStatus(e.target.value)} style={{ ...S.inp, width: 'auto' }}>
            <option value="All">All Status</option>
            {APP_STATUSES.map(s => <option key={s}>{s}</option>)}
          </select>
          <select value={filterJob} onChange={e => setFilterJob(e.target.value)} style={{ ...S.inp, width: 'auto', maxWidth: 200 }}>
            <option value="All">All Jobs</option>
            {jobs.map(j => <option key={j.id} value={j.id}>{j.title} — {j.company}</option>)}
          </select>
        </div>

        {/* TABLE */}
        <div style={S.card}>
          <div style={{ fontSize: 13, fontWeight: 600, marginBottom: 14 }}>{filtered.length} Applications</div>
          {filtered.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '40px', color: 'var(--mu)' }}>
              <div style={{ fontSize: 32, marginBottom: 8 }}>📨</div>
              <div>No applications yet</div>
            </div>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column' as any, gap: 10 }}>
              {filtered.map(app => (
                <div key={app.id} style={{ background: 'var(--bg3)', borderRadius: 10, padding: '14px 16px', display: 'flex', gap: 16, alignItems: 'flex-start', flexWrap: 'wrap' as any, border: '1px solid var(--bd)' }}>
                  <div style={{ flex: 1, minWidth: 200 }}>
                    <div style={{ fontWeight: 600, fontSize: 14 }}>{app.full_name}</div>
                    <div style={{ fontSize: 12, color: 'var(--mu)', marginTop: 2 }}>{app.email} {app.mobile && `· ${app.mobile}`}</div>
                    <div style={{ fontSize: 12, color: 'var(--ac)', marginTop: 4 }}>{app.job?.title} @ {app.job?.company}</div>
                    {app.cover_letter && (
                      <div style={{ fontSize: 11, color: 'var(--mu)', marginTop: 6, fontStyle: 'italic', borderLeft: '2px solid var(--bd)', paddingLeft: 8, lineHeight: 1.5 }}>
                        "{app.cover_letter.slice(0, 120)}{app.cover_letter.length > 120 ? '...' : ''}"
                      </div>
                    )}
                    <div style={{ fontSize: 10, color: 'var(--mu2)', marginTop: 6 }}>Applied {new Date(app.created_at).toLocaleDateString('en-IN')}</div>
                  </div>
                  <div style={{ display: 'flex', flexDirection: 'column' as any, gap: 8, flexShrink: 0 }}>
                    <select value={app.status} onChange={e => updateStatus(app.id, e.target.value)}
                      style={{ background: `${STATUS_C[app.status] || '#888'}22`, color: STATUS_C[app.status] || '#888', border: `1px solid ${STATUS_C[app.status] || '#888'}55`, borderRadius: 6, padding: '5px 10px', fontSize: 11, fontWeight: 600, cursor: 'pointer', outline: 'none', fontFamily: 'Outfit,sans-serif' }}>
                      {APP_STATUSES.map(s => <option key={s} value={s}>{s}</option>)}
                    </select>
                    <input value={app.notes || ''} onChange={e => updateNotes(app.id, e.target.value)} placeholder="Add note..." style={{ ...S.inp, fontSize: 11, padding: '5px 8px', width: 160 }} />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
