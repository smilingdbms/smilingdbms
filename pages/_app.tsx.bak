    '--bg':'#0f1117','--bg2':'rgba(255,255,255,0.07)','--bg3':'rgba(255,255,255,0.10)','--bg4':'rgba(255,255,255,0.15)',
    '--tx':'#f1f5f9','--mu':'#94a3b8','--mu2':'#64748b',
