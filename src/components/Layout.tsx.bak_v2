import React, { useState, useEffect, useRef } from 'react';
import { useRouter } from 'next/router';
import Link from 'next/link';
import { supabase } from '../lib/supabase';

// ═══════════════════════════════════════════════════════════
// Layout.tsx v2.0 — RecruitBase Pro
// Fixed: hydration bug, brand name, Supabase auth + logout
// Wrap any dashboard page: <Layout>{children}</Layout>
// ═══════════════════════════════════════════════════════════

export default function Layout({ children }: { children: React.ReactNode }) {
  const router = useRouter();
  const [isCollapsed, setIsCollapsed] = useState(false);
  const [isMobileOpen, setIsMobileOpen] = useState(false);
  const [isMobile, setIsMobile] = useState(false); // ✅ FIX: no window in render
  const [openMenu, setOpenMenu] = useState<string | null>(null);
  const [brandLogo, setBrandLogo] = useState<string | null>(null);
  const [userName, setUserName] = useState('');
  const [userRole, setUserRole] = useState('');
  const [loggingOut, setLoggingOut] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  // ✅ FIX: isMobile via useEffect — no hydration error
  useEffect(() => {
    const check = () => setIsMobile(window.innerWidth <= 768);
    check();
    window.addEventListener('resize', check);
    return () => window.removeEventListener('resize', check);
  }, []);

  // Load saved logo
  useEffect(() => {
    try {
      const savedLogo = localStorage.getItem('rbp_logo');
      if (savedLogo) setBrandLogo(savedLogo);
    } catch {}
  }, []);

  // ✅ FIX: Supabase auth — fetch user info
  useEffect(() => {
    const fetchUser = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { router.push('/'); return; }
      // Get name + role from app_users table
      const { data } = await supabase
        .from('app_users')
        .select('full_name, role')
        .eq('id', user.id)
        .single();
      if (data) {
        setUserName(data.full_name || user.email || '');
        setUserRole(data.role || '');
      }
    };
    fetchUser();
  }, []);

  // Close sidebar on route change (mobile)
  useEffect(() => { setIsMobileOpen(false); }, [router.pathname]);

  const handleLogoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        const base64 = reader.result as string;
        setBrandLogo(base64);
        try { localStorage.setItem('rbp_logo', base64); } catch {}
      };
      reader.readAsDataURL(file);
    }
  };

  const toggleSidebar = () => setIsCollapsed(!isCollapsed);
  const toggleMobileSidebar = () => setIsMobileOpen(!isMobileOpen);

  const handleAccordion = (menuId: string) => {
    if (isCollapsed && !isMobileOpen) {
      setIsCollapsed(false);
      setTimeout(() => setOpenMenu(openMenu === menuId ? null : menuId), 150);
    } else {
      setOpenMenu(openMenu === menuId ? null : menuId);
    }
  };

  // ✅ FIX: Logout with Supabase
  const handleLogout = async () => {
    setLoggingOut(true);
    await supabase.auth.signOut();
    router.push('/');
  };

  const roleLabel = userRole.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const isSuperAdmin = ['super_admin', 'platform_admin', 'platform_manager'].includes(userRole);

  const menuData = [
    {
      id: 'master', icon: '🌐', title: 'Master DB',
      submenus: [
        { name: '⚡ All Job Seekers', path: '/dashboard/master' },
        { name: '🏢 All Companies', path: '/dashboard/master' },
        { name: '📊 Platform Analytics', path: '/dashboard/master' },
        { name: '💰 Revenue Dashboard', path: '/dashboard/master' },
      ]
    },
    {
      id: 'dash', icon: '📊', title: 'Dashboard',
      submenus: [
        { name: 'Recruiter Performance', path: '/dashboard/admin#recruiter-performance' },
        { name: 'Hiring Pipeline', path: '/dashboard/admin#pipeline-overview' },
        { name: 'Active Jobs', path: '/dashboard/jobs' },
        { name: 'Interview Tracker', path: '/dashboard/interviews' },
        { name: 'Applications Summary', path: '/dashboard/applications' },
        { name: 'Candidate Database', path: '/dashboard/master' },
        { name: 'Team Activity', path: '/dashboard/communications' },
        { name: 'Reports & Analytics', path: '/dashboard/analytics' },
        { name: 'ATS Settings', path: '/dashboard/settings' }
      ]
    },
    {
      id: 'jobs', icon: '💼', title: 'Jobs',
      submenus: [
        { name: 'All Jobs', path: '/dashboard/jobs' },
        { name: 'Active Jobs', path: '/dashboard/jobs#active-jobs' },
        { name: 'Draft Jobs', path: '/dashboard/jobs#draft-jobs' },
        { name: 'Closed Jobs', path: '/dashboard/jobs#closed-jobs' },
        { name: 'Urgent Jobs', path: '/dashboard/jobs#urgent-jobs' },
        { name: 'Assigned Jobs', path: '/dashboard/jobs#assigned-jobs' },
        { name: 'Client Wise Jobs', path: '/dashboard/jobs#client-wise-jobs' },
        { name: 'Industry Wise Jobs', path: '/dashboard/jobs#industry-wise-jobs' },
        { name: 'Remote Jobs', path: '/dashboard/jobs#remote-jobs' },
        { name: 'Walk-In Jobs', path: '/dashboard/jobs#walkin-jobs' },
        { name: 'Bulk Job Import', path: '/dashboard/import' },
        { name: 'Job Templates', path: '/dashboard/jobs#templates' },
        { name: 'Job Analytics', path: '/dashboard/analytics#job-analytics' },
        { name: 'Archived Jobs', path: '/dashboard/jobs#archived' }
      ]
    },
    {
      id: 'apps', icon: '📁', title: 'Applications',
      submenus: [
        { name: 'All Applications', path: '/dashboard/applications' },
        { name: 'New Applications', path: '/dashboard/applications#new' },
        { name: 'Screened', path: '/dashboard/applications#screened' },
        { name: 'Shortlisted', path: '/dashboard/applications#shortlisted' },
        { name: 'Rejected', path: '/dashboard/applications#rejected' },
        { name: 'Interview Scheduled', path: '/dashboard/interviews' },
        { name: 'Offer Released', path: '/dashboard/applications#offer-released' },
        { name: 'Joined Candidates', path: '/dashboard/applications#joined' },
        { name: 'Hold Applications', path: '/dashboard/applications#hold' },
        { name: 'Duplicate Applications', path: '/dashboard/applications#duplicates' },
        { name: 'Source Wise', path: '/dashboard/applications#source-wise' },
        { name: 'Bulk Actions', path: '/dashboard/applications#bulk-actions' },
        { name: 'Application Analytics', path: '/dashboard/analytics#application-analytics' },
        { name: 'Archived Applications', path: '/dashboard/applications#archived' }
      ]
    },
    {
      id: 'cand', icon: '👥', title: 'Candidates',
      submenus: [
        { name: 'All Candidates', path: '/dashboard/master' },
        { name: 'Active Candidates', path: '/dashboard/master#active' },
        { name: 'Available Candidates', path: '/dashboard/master#available' },
        { name: 'Assigned Candidates', path: '/dashboard/master#assigned' },
        { name: 'Blacklisted', path: '/dashboard/master#blacklisted' },
        { name: 'Duplicate Profiles', path: '/dashboard/master#duplicates' },
        { name: 'Candidate Notes', path: '/dashboard/master#notes' },
        { name: 'Candidate Tags', path: '/dashboard/master#tags' },
        { name: 'Candidate Timeline', path: '/dashboard/master#timeline' },
        { name: 'Candidate Documents', path: '/dashboard/master#documents' },
        { name: 'Activity Logs', path: '/dashboard/master#activity-logs' }
      ]
    },
    {
      id: 'addcand', icon: '➕', title: 'Add Candidate',
      submenus: [
        { name: 'Manual Entry', path: '/dashboard/master#manual-entry' },
        { name: 'Resume Upload', path: '/dashboard/master#resume-upload' },
        { name: 'AI Resume Parser', path: '/dashboard/master#ai-parser' },
        { name: 'Bulk Resume Upload', path: '/dashboard/import' },
        { name: 'LinkedIn Import', path: '/dashboard/master#linkedin-import' },
        { name: 'Naukri Import', path: '/dashboard/master#naukri-import' },
        { name: 'Duplicate Check', path: '/dashboard/master#duplicate-check' },
        { name: 'Import History', path: '/dashboard/import#history' }
      ]
    },
    {
      id: 'int', icon: '📅', title: 'Interviews',
      submenus: [
        { name: 'All Interviews', path: '/dashboard/interviews' },
        { name: "Today's Interviews", path: '/dashboard/interviews#today' },
        { name: 'Upcoming Interviews', path: '/dashboard/interviews#upcoming' },
        { name: 'Completed Interviews', path: '/dashboard/interviews#completed' },
        { name: 'Rescheduled', path: '/dashboard/interviews#rescheduled' },
        { name: 'Cancelled', path: '/dashboard/interviews#cancelled' },
        { name: 'Panel Assignment', path: '/dashboard/interviews#panel-assignment' },
        { name: 'Interview Feedback', path: '/dashboard/interviews#feedback' },
        { name: 'Interview Rounds', path: '/dashboard/interviews#rounds' },
        { name: 'Interview Calendar', path: '/dashboard/interviews#calendar' },
        { name: 'Zoom / Meet Links', path: '/dashboard/interviews#meeting-links' },
        { name: 'Candidate Ratings', path: '/dashboard/interviews#ratings' },
        { name: 'Interview Analytics', path: '/dashboard/analytics#interview-analytics' }
      ]
    },
    {
      id: 'pipe', icon: '🚀', title: 'Pipeline',
      submenus: [
        { name: 'Kanban Pipeline', path: '/dashboard/applications#kanban' },
        { name: 'Stage Management', path: '/dashboard/applications#stages' },
        { name: 'Recruiter Wise', path: '/dashboard/applications#recruiter-wise' },
        { name: 'Client Wise', path: '/dashboard/applications#client-wise' },
        { name: 'Offer Pipeline', path: '/dashboard/applications#offer-pipeline' },
        { name: 'Joining Pipeline', path: '/dashboard/applications#joining-pipeline' },
        { name: 'Dropout Tracking', path: '/dashboard/applications#dropouts' },
        { name: 'Conversion Funnel', path: '/dashboard/analytics#conversion-funnel' },
        { name: 'Pipeline Analytics', path: '/dashboard/analytics#pipeline-analytics' }
      ]
    },
    {
      id: 'bd', icon: '🏢', title: 'BD & Clients',
      submenus: [
        { name: 'BD Pipeline', path: '/dashboard/bd' },
        { name: 'All Clients', path: '/dashboard/bd#all-clients' },
        { name: 'Active Clients', path: '/dashboard/bd#active-clients' },
        { name: 'New Leads', path: '/dashboard/bd#new-leads' },
        { name: 'Stakeholders', path: '/dashboard/stakeholders' },
        { name: 'Client Billing', path: '/dashboard/company' },
        { name: 'BD Analytics', path: '/dashboard/analytics#bd-analytics' }
      ]
    },
    {
      id: 'place', icon: '🏆', title: 'Placements',
      submenus: [
        { name: 'Successful Placements', path: '/dashboard/applications#successful-placements' },
        { name: 'Joining Candidates', path: '/dashboard/applications#joining-candidates' },
        { name: 'Offer Accepted', path: '/dashboard/applications#offer-accepted' },
        { name: 'Offer Declined', path: '/dashboard/applications#offer-declined' },
        { name: 'Replacement Tracker', path: '/dashboard/applications#replacement-tracker' },
        { name: 'Incentive Tracking', path: '/dashboard/analytics#incentives' },
        { name: 'Placement Analytics', path: '/dashboard/analytics#placement-analytics' }
      ]
    },
    {
      id: 'follow', icon: '📞', title: 'Follow Ups',
      submenus: [
        { name: "Today's Followups", path: '/dashboard/communications#today-followups' },
        { name: 'Pending Followups', path: '/dashboard/communications#pending-followups' },
        { name: 'Overdue Followups', path: '/dashboard/communications#overdue-followups' },
        { name: 'Candidate Followups', path: '/dashboard/communications#candidate-followups' },
        { name: 'Client Followups', path: '/dashboard/communications#client-followups' },
        { name: 'WhatsApp Followups', path: '/dashboard/communications#whatsapp-followups' },
        { name: 'Email Followups', path: '/dashboard/communications#email-followups' },
        { name: 'Call Logs', path: '/dashboard/communications#call-logs' },
        { name: 'Followup Templates', path: '/dashboard/communications#templates' }
      ]
    },
    {
      id: 'analytics', icon: '📈', title: 'Reports & Analytics',
      submenus: [
        { name: 'Recruitment Dashboard', path: '/dashboard/analytics' },
        { name: 'Recruiter Performance', path: '/dashboard/analytics#recruiter-performance' },
        { name: 'Team Performance', path: '/dashboard/analytics#team-performance' },
        { name: 'Job Analytics', path: '/dashboard/analytics#job-analytics' },
        { name: 'Placement Reports', path: '/dashboard/analytics#placement-reports' },
        { name: 'Revenue Reports', path: '/dashboard/analytics#revenue-reports' },
        { name: 'Time-To-Hire Reports', path: '/dashboard/analytics#time-to-hire' },
        { name: 'Custom Reports', path: '/dashboard/analytics#custom-reports' },
        { name: 'Forecasting & AI Insights', path: '/dashboard/analytics#forecasting-ai' }
      ]
    },
    {
      id: 'team', icon: '🛡️', title: 'Team & Access',
      submenus: [
        { name: '🛡️ Admin Center', path: '/dashboard/admin' },
        { name: 'Invite Members', path: '/dashboard/invite' },
        { name: 'Permissions', path: '/dashboard/permissions' },
        { name: 'Company Profile', path: '/dashboard/company' },
        { name: 'Company Settings', path: '/dashboard/company-permissions' }
      ]
    },
    {
      id: 'comm', icon: '💬', title: 'Communications',
      submenus: [
        { name: 'All Messages', path: '/dashboard/communications' },
        { name: 'WhatsApp', path: '/dashboard/communications#whatsapp' },
        { name: 'Email Campaigns', path: '/dashboard/communications#email' },
        { name: 'SMS', path: '/dashboard/communications#sms' },
        { name: 'Templates', path: '/dashboard/communications#templates' },
        { name: 'Reminder Center', path: '/dashboard/communications#reminders' }
      ]
    },
    {
      id: 'settings', icon: '⚙️', title: 'Settings',
      submenus: [
        { name: 'ATS Preferences', path: '/dashboard/settings' },
        { name: 'Workflow Settings', path: '/dashboard/settings#workflow-settings' },
        { name: 'Email Templates', path: '/dashboard/settings#email-templates' },
        { name: 'WhatsApp Templates', path: '/dashboard/settings#whatsapp-templates' },
        { name: 'Notification Settings', path: '/dashboard/settings#notification-settings' },
        { name: 'Permission Settings', path: '/dashboard/permissions' },
        { name: 'AI Parser Settings', path: '/dashboard/settings#ai-parser' },
        { name: 'Integration Settings', path: '/dashboard/settings#integration-settings' },
        { name: 'Audit Settings', path: '/dashboard/settings#audit-settings' }
      ]
    }
  ];

  const isActiveMenu = (menu: typeof menuData[0]) =>
    menu.submenus.some(s => router.pathname === s.path.split('#')[0]);

  return (
    <>
      <style dangerouslySetInnerHTML={{__html: `
        * { box-sizing: border-box; }
        :root {
          --matte-black: #050810;
          --dark-panel: #11182D;
          --electric-blue: #3B82F6;
          --text-muted: #9CA3AF;
          --text-light: #F3F4F6;
          --border-color: #1F2937;
        }
        body { margin: 0; padding: 0; }
        .os-layout { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--matte-black); color: var(--text-light); display: flex; height: 100vh; overflow: hidden; }
        .os-sidebar-scroll { flex: 1; overflow-y: auto; padding: 8px 0 12px; }
        .os-sidebar-scroll::-webkit-scrollbar { width: 4px; }
        .os-sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .os-sidebar-scroll::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
        .os-menu-item { padding: 11px 18px; display: flex; align-items: center; cursor: pointer; color: var(--text-muted); border-left: 3px solid transparent; white-space: nowrap; overflow: hidden; transition: background 0.15s, color 0.15s; }
        .os-menu-item:hover { background: rgba(59,130,246,0.08); color: var(--text-light); }
        .os-menu-item.active { background: rgba(59,130,246,0.12); color: #60A5FA; border-left-color: var(--electric-blue); }
        .os-submenu-item { text-decoration: none; display: block; padding: 9px 18px 9px 58px; font-size: 12.5px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.15s, background 0.15s, padding-left 0.15s; }
        .os-submenu-item:hover { color: var(--electric-blue); background: rgba(59,130,246,0.05); padding-left: 63px; }
        .os-submenu-item.active { color: #60A5FA; font-weight: 600; }
        .os-user-bar { padding: 12px 16px; border-top: 1px solid var(--border-color); display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
        .os-logout-btn { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #EF4444; border-radius: 7px; padding: 7px 14px; font-size: 12px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background 0.15s; width: 100%; margin-top: 6px; }
        .os-logout-btn:hover { background: rgba(239,68,68,0.2); }
        .master-menu-item { background: rgba(124,58,237,0.1) !important; border-left-color: #7C3AED !important; color: #A78BFA !important; }
        .master-menu-item:hover { background: rgba(124,58,237,0.18) !important; }
        .os-mobile-header { display: none; align-items: center; justify-content: space-between; padding: 0 20px; height: 58px; background: var(--dark-panel); border-bottom: 1px solid var(--border-color); position: fixed; top: 0; left: 0; right: 0; z-index: 50; }
        @media (max-width: 768px) {
          .os-mobile-header { display: flex; }
          .os-desktop-toggle { display: none !important; }
          .os-main-content { padding-top: 78px !important; }
        }
        @media (min-width: 769px) {
          .os-mobile-only { display: none !important; }
        }
      `}} />

      {/* MOBILE HEADER */}
      <div className="os-mobile-header">
        <div style={{ fontWeight: 900, fontSize: '18px', color: 'var(--electric-blue)', letterSpacing: '0.5px' }}>
          RecruitBase Pro
        </div>
        <button
          onClick={toggleMobileSidebar}
          style={{ background: 'none', border: 'none', color: 'var(--electric-blue)', fontSize: '24px', cursor: 'pointer' }}
        >☰</button>
      </div>

      {/* MOBILE OVERLAY */}
      {isMobileOpen && (
        <div
          className="os-mobile-only"
          onClick={toggleMobileSidebar}
          style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.6)', zIndex: 98 }}
        />
      )}

      <div className="os-layout">

        {/* ═══ SIDEBAR ═══ */}
        <div style={{
          width: isCollapsed ? '68px' : '280px',
          background: 'var(--dark-panel)',
          borderRight: '1px solid var(--border-color)',
          display: 'flex',
          flexDirection: 'column',
          zIndex: 99,
          flexShrink: 0,
          height: '100vh',
          position: isMobile ? 'fixed' : 'relative',    // ✅ FIXED: no window in render
          transform: isMobile && !isMobileOpen ? 'translateX(-100%)' : 'translateX(0)',
          transition: 'width 0.28s ease, transform 0.28s ease',
          overflow: 'hidden'
        }}>

          {/* Logo + Toggle */}
          <div style={{
            height: '64px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: isCollapsed ? 'center' : 'space-between',
            padding: isCollapsed ? '0 10px' : '0 16px',
            borderBottom: '1px solid var(--border-color)',
            flexShrink: 0
          }}>
            <input type="file" ref={fileInputRef} onChange={handleLogoUpload} accept="image/*" style={{ display: 'none' }} />

            {!isCollapsed && (
              <div
                onClick={() => fileInputRef.current?.click()}
                title="Click to upload your logo"
                style={{ display: 'flex', alignItems: 'center', gap: '10px', cursor: 'pointer', overflow: 'hidden' }}
              >
                {brandLogo
                  ? <img src={brandLogo} alt="Logo" style={{ height: '28px', maxWidth: '140px', objectFit: 'contain' }} />
                  : (
                    <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                      <div style={{ width: '30px', height: '30px', borderRadius: '8px', background: 'rgba(59,130,246,0.15)', display: 'flex', alignItems: 'center', justifyContent: 'center', color: 'var(--electric-blue)', fontWeight: 800, fontSize: '14px', flexShrink: 0 }}>R</div>
                      <div>
                        <div style={{ fontWeight: 800, fontSize: '13px', color: 'var(--text-light)', lineHeight: 1.2 }}>RecruitBase Pro</div>
                        <div style={{ fontSize: '9px', color: 'var(--text-muted)', letterSpacing: '1.2px', textTransform: 'uppercase' }}>
                          {roleLabel || 'Dashboard'}
                        </div>
                      </div>
                    </div>
                  )
                }
              </div>
            )}

            <button
              className="os-desktop-toggle"
              onClick={toggleSidebar}
              title={isCollapsed ? 'Expand sidebar' : 'Collapse sidebar'}
              style={{ background: 'none', border: 'none', color: 'var(--electric-blue)', fontSize: '20px', cursor: 'pointer', flexShrink: 0, padding: '4px' }}
            >
              {isCollapsed ? '☰' : '✖'}
            </button>
          </div>

          {/* Menu Items */}
          <div className="os-sidebar-scroll">
            {menuData.filter(menu => !menu.superAdminOnly || isSuperAdmin).map((menu) => {
              const isOpen = openMenu === menu.id;
              const isActive = isActiveMenu(menu);
              return (
                <div key={menu.id}>
                  <div
                    className={`os-menu-item ${isActive ? 'active' : ''} ${menu.id === 'master' ? 'master-menu-item' : ''}`}
                    onClick={() => handleAccordion(menu.id)}
                    title={isCollapsed ? menu.title : undefined}
                  >
                    <span style={{ fontSize: '18px', minWidth: '28px', display: 'flex', justifyContent: 'center', flexShrink: 0 }}>
                      {menu.icon}
                    </span>
                    {!isCollapsed && (
                      <>
                        <span style={{ marginLeft: '12px', fontSize: '13.5px', fontWeight: isActive ? 600 : 500, flex: 1 }}>
                          {menu.title}
                        </span>
                        <span style={{ fontSize: '11px', color: 'var(--text-muted)', marginLeft: '4px' }}>
                          {isOpen ? '▼' : '▶'}
                        </span>
                      </>
                    )}
                  </div>

                  {isOpen && !isCollapsed && (
                    <div style={{ background: '#070C1A', paddingBottom: '4px' }}>
                      {menu.submenus.map((sub, idx) => {
                        const subActive = router.pathname === sub.path.split('#')[0] && !sub.path.includes('#');
                        return (
                          <Link
                            href={sub.path}
                            key={idx}
                            className={`os-submenu-item ${subActive ? 'active' : ''}`}
                            onClick={() => setIsMobileOpen(false)}
                          >
                            · {sub.name}
                          </Link>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </div>

          {/* ✅ FIX: User info + Logout at bottom */}
          <div className="os-user-bar" style={{ flexDirection: 'column', alignItems: 'flex-start' }}>
            {!isCollapsed && userName && (
              <div style={{ width: '100%', marginBottom: '2px' }}>
                <div style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text-light)', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                  {userName}
                </div>
                {roleLabel && (
                  <div style={{ fontSize: '10px', color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: '0.8px' }}>
                    {roleLabel}
                  </div>
                )}
              </div>
            )}
            <button
              className="os-logout-btn"
              onClick={handleLogout}
              disabled={loggingOut}
              title="Logout"
            >
              {isCollapsed ? '🚪' : (loggingOut ? 'Logging out...' : '🚪 Logout')}
            </button>
          </div>
        </div>

        {/* ═══ MAIN CONTENT ═══ */}
        <main
          className="os-main-content"
          style={{
            flex: 1,
            overflowY: 'auto',
            background: 'var(--matte-black)',
            padding: '32px',
            paddingLeft: isMobile ? '20px' : '32px',
          }}
        >
          {children}
        </main>

      </div>
    </>
  );
}
